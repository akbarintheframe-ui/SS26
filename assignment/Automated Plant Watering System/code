#include <WiFi.h>
#include <HTTPClient.h>
#include <ArduinoJson.h>

// ---------------- Pin config ----------------
#define SOIL_PIN     35
#define LDR_PIN      32
#define BUTTON_PIN   27
#define PUMP_PIN     26

// ---------------- Thresholds (placeholders — calibrate on real hardware) ----------------
#define DRY_THRESHOLD        2800
#define OPTIMAL_THRESHOLD    1800
#define OVERCAST_THRESHOLD   2000

#define READ_INTERVAL_MS     (30UL * 60UL * 1000UL)   // 30 minutes
#define LOCKOUT_DURATION_MS  (5UL * 60UL * 1000UL)     // 5 minutes
#define PUMP_RUN_DURATION_MS 5000UL                    // fixed watering burst length

// ---------------- WiFi / API config ----------------
const char* WIFI_SSID     = "YOUR_WIFI_SSID";
const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";
const char* API_KEY       = "YOUR_OPENWEATHERMAP_KEY";
const float LATITUDE  = 34.0837;
const float LONGITUDE = 74.7973;

// ---------------- State ----------------
enum SoilState { DRY, OPTIMAL, WET };
enum LightState { CLEAR, OVERCAST };

unsigned long lastReadTime = 0;
unsigned long lastActivationTime = 0;
bool lockoutActive = false;

// ---------------- Sensor + logic functions (built in earlier steps) ----------------

SoilState evaluateSoil(int rawValue) {
  if (rawValue >= DRY_THRESHOLD) return DRY;
  if (rawValue >= OPTIMAL_THRESHOLD) return OPTIMAL;
  return WET;
}

LightState evaluateLight(int rawValue) {
  if (rawValue >= OVERCAST_THRESHOLD) return OVERCAST;
  return CLEAR;
}

bool checkRecentRain() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi not connected — cannot check rain.");
    return true;  // can't confirm safety, so assume rain
  }

  HTTPClient http;
  String url = "http://api.openweathermap.org/data/2.5/weather?lat="
               + String(LATITUDE, 4) + "&lon=" + String(LONGITUDE, 4)
               + "&appid=" + API_KEY;

  http.begin(url);
  int httpCode = http.GET();

  if (httpCode != 200) {
    Serial.print("API call failed, code: ");
    Serial.println(httpCode);
    http.end();
    return true;  // failure → assume rain, block watering
  }

  String payload = http.getString();
  http.end();

  StaticJsonDocument<1024> doc;
  deserializeJson(doc, payload);

  bool isRaining = doc.containsKey("rain");
  Serial.print("Rain detected by API: ");
  Serial.println(isRaining ? "YES" : "NO");

  return isRaining;
}

bool isLockoutActive() {
  if (!lockoutActive) return false;
  if (millis() - lastActivationTime >= LOCKOUT_DURATION_MS) {
    lockoutActive = false;
    return false;
  }
  return true;
}

void runPump(const char* reason) {
  Serial.print("Pump ON — reason: ");
  Serial.println(reason);

  digitalWrite(PUMP_PIN, HIGH);
  delay(PUMP_RUN_DURATION_MS);
  digitalWrite(PUMP_PIN, LOW);

  lastActivationTime = millis();
  lockoutActive = true;
}

// ---------------- The core decision function ----------------

void evaluateIrrigation() {
  int soilRaw = analogRead(SOIL_PIN);
  int ldrRaw  = analogRead(LDR_PIN);

  SoilState soil = evaluateSoil(soilRaw);
  LightState light = evaluateLight(ldrRaw);
  bool rainDetected = checkRecentRain();

  Serial.print("Soil: ");
  Serial.print(soilRaw);
  Serial.print(" | Light: ");
  Serial.print(ldrRaw);
  Serial.print(" | Rain(API): ");
  Serial.println(rainDetected ? "YES" : "NO");

  if (soil != DRY) {
    Serial.println("Soil not dry — no watering needed.");
    return;
  }

  if (light == OVERCAST) {
    Serial.println("Overcast (LDR) — watering blocked as rain precaution.");
    return;
  }

  if (rainDetected) {
    Serial.println("API reports rain — watering blocked.");
    return;
  }

  // All three conditions passed: soil is dry, sky is clear, API confirms no rain
  runPump("scheduled — soil dry, conditions clear");
}

// ---------------- Manual override ----------------

void checkManualOverride() {
  bool buttonPressed = (digitalRead(BUTTON_PIN) == LOW);

  if (buttonPressed && !isLockoutActive()) {
    runPump("manual override");
  } else if (buttonPressed && isLockoutActive()) {
    Serial.println("Button pressed, but lockout active — ignored.");
  }
}

// ---------------- Setup / loop ----------------

void setup() {
  Serial.begin(115200);
  pinMode(BUTTON_PIN, INPUT_PULLUP);
  pinMode(PUMP_PIN, OUTPUT);

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.println("Connecting to WiFi...");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi connected.");
}

void loop() {
  checkManualOverride();   // checked constantly, every loop cycle

  if (millis() - lastReadTime >= READ_INTERVAL_MS) {
    lastReadTime = millis();
    evaluateIrrigation();   // only checked every 30 minutes
  }

  delay(200);
}
