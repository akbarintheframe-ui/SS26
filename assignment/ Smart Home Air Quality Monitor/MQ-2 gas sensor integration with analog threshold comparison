/*
 * Air Quality Monitoring System — Tier 1 (Local Safety Loop)
 * ESP32 + MQ-2 (CO/smoke) + DHT11 (temp/humidity)
 * LED status (green/yellow/red) + buzzer (3 tones) + Serial CSV logging
 *
 * Runs fully standalone — no WiFi/network dependency in this tier.
 */

#include <DHT.h>

// ---------------- PIN CONFIG ----------------
#define MQ2_PIN      34   // ADC1 pin — avoid ADC2 (conflicts with WiFi later)
#define DHTPIN       5
#define DHTTYPE      DHT11
#define GREEN_LED    25
#define YELLOW_LED   26
#define RED_LED      27
#define BUZZER_PIN   14
// ---------------------------------------------

#define WARMUP_TIME_MS         20000   // MQ-2 heater stabilization time
#define CALIBRATION_SAMPLES    50
#define ELEVATED_MULTIPLIER    1.5
#define DANGER_MULTIPLIER      2.5
#define READ_INTERVAL_MS       2000

#define TONE_ELEVATED  1000
#define TONE_DANGER    2500

DHT dht(DHTPIN, DHTTYPE);

enum AirQualityState { SAFE, ELEVATED, DANGER };
AirQualityState currentState = SAFE;
AirQualityState previousState = SAFE;  // used to only re-trigger buzzer on change

int baselineMQ2 = 0;
unsigned long lastReadTime = 0;

// ---------------- MQ-2 calibration ----------------
int calibrateMQ2() {
  Serial.println("Calibrating MQ-2 in clean air...");
  long sum = 0;
  for (int i = 0; i < CALIBRATION_SAMPLES; i++) {
    sum += analogRead(MQ2_PIN);
    delay(100);
  }
  int baseline = sum / CALIBRATION_SAMPLES;
  Serial.print("Baseline established: ");
  Serial.println(baseline);
  return baseline;
}

// ---------------- Threshold logic ----------------
AirQualityState evaluateThreshold(int mq2Value) {
  if (mq2Value >= baselineMQ2 * DANGER_MULTIPLIER) {
    return DANGER;
  } else if (mq2Value >= baselineMQ2 * ELEVATED_MULTIPLIER) {
    return ELEVATED;
  }
  return SAFE;
}

// ---------------- LED output ----------------
void driveLED(AirQualityState state) {
  digitalWrite(GREEN_LED, LOW);
  digitalWrite(YELLOW_LED, LOW);
  digitalWrite(RED_LED, LOW);

  switch (state) {
    case SAFE:     digitalWrite(GREEN_LED, HIGH);  break;
    case ELEVATED: digitalWrite(YELLOW_LED, HIGH); break;
    case DANGER:   digitalWrite(RED_LED, HIGH);    break;
  }
}

// ---------------- Buzzer output (only acts on state CHANGE) ----------------
void driveBuzzer(AirQualityState state) {
  if (state == previousState) return;

  switch (state) {
    case SAFE:
      noTone(BUZZER_PIN);
      break;
    case ELEVATED:
      tone(BUZZER_PIN, TONE_ELEVATED, 200);
      break;
    case DANGER:
      tone(BUZZER_PIN, TONE_DANGER);   // no duration = keeps playing until noTone()
      break;
  }
}

// ---------------- CSV logging ----------------
void logReadingCSV(unsigned long timestamp, int mq2Value, float mq2Ratio,
                    float temperature, float humidity, AirQualityState state) {
  Serial.print(timestamp);
  Serial.print(",");
  Serial.print(mq2Value);
  Serial.print(",");
  Serial.print(mq2Ratio, 2);
  Serial.print(",");

  if (isnan(temperature)) Serial.print("NA");
  else Serial.print(temperature, 1);
  Serial.print(",");

  if (isnan(humidity)) Serial.print("NA");
  else Serial.print(humidity, 1);
  Serial.print(",");

  switch (state) {
    case SAFE:     Serial.println("SAFE");     break;
    case ELEVATED: Serial.println("ELEVATED"); break;
    case DANGER:   Serial.println("DANGER");   break;
  }
}

// ---------------- Setup ----------------
void setup() {
  Serial.begin(115200);
  delay(500);

  pinMode(GREEN_LED, OUTPUT);
  pinMode(YELLOW_LED, OUTPUT);
  pinMode(RED_LED, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);

  dht.begin();

  Serial.println("Warming up MQ-2 sensor...");
  delay(WARMUP_TIME_MS);
  baselineMQ2 = calibrateMQ2();

  // CSV header — printed once at boot
  Serial.println("timestamp_ms,mq2_raw,mq2_ratio,temperature_c,humidity_pct,state");
}

// ---------------- Main loop ----------------
void loop() {
  if (millis() - lastReadTime >= READ_INTERVAL_MS) {
    lastReadTime = millis();

    int mq2Value = analogRead(MQ2_PIN);
    float humidity = dht.readHumidity();
    float temperature = dht.readTemperature();
    float mq2Ratio = (float)mq2Value / baselineMQ2;

    currentState = evaluateThreshold(mq2Value);

    driveLED(currentState);
    driveBuzzer(currentState);
    logReadingCSV(millis(), mq2Value, mq2Ratio, temperature, humidity, currentState);

    previousState = currentState;
  }
}
