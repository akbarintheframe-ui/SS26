    {
        "id": "0999d47ce1a621cf",
        "type": "function",
        "z": "d451bc07da7c437a",
        "name": "function 1",
        "func": "// Simulated readings for 3 AquaWatch nodes\nconst nodes = [\n    { id: \"node1\", name: \"Raw Water Inlet\", ph: 7.6, tds: 320, turb: 3.2, temp: 26.5 },\n    { id: \"node2\", name: \"Post-RO Treatment\", ph: 7.1, tds: 8.0, turb: 0.6, temp: 25.8 },\n    { id: \"node3\", name: \"Point of Use\", ph: 7.0, tds: 7.5, turb: 0.4, temp: 25.5 }\n];\n\nconst messages = nodes.map(n => {\n    // add small random jitter so values change slightly each cycle\n    const payload = {\n        node: n.id,\n        node_name: n.name,\n        ph: +(n.ph + (Math.random() - 0.5) * 0.2).toFixed(2),\n        tds: +(n.tds + (Math.random() - 0.5) * 4).toFixed(1),\n        turbidity: +(n.turb + (Math.random() - 0.5) * 0.3).toFixed(2),\n        temperature: +(n.temp + (Math.random() - 0.5) * 1.0).toFixed(1)\n    };\n\n    return {\n        topic: `aquawatch/${n.id}/data`,\n        payload: JSON.stringify(payload)\n    };\n});\n\n// Send all 3 messages out together\nreturn [messages];\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 160,
        "wires": [
            [
                "3588b5077f63947b"
            ]
        ]
    },
