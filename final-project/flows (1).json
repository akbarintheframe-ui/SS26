        "func": "// Splits one node's combined reading into 4 separate messages\nconst data = msg.payload;\n\nconst msgPh   = { payload: data.ph,          topic: \"ph\" };\nconst msgTds  = { payload: data.tds,         topic: \"tds\" };\nconst msgTurb = { payload: data.turbidity,   topic: \"turbidity\" };\nconst msgTemp = { payload: data.temperature, topic: \"temperature\" };\n\nreturn [msgPh, msgTds, msgTurb, msgTemp];\n",
