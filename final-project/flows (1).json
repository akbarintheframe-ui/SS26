    {
        "id": "cba33fb9be822db9",
        "type": "function",
        "z": "d451bc07da7c437a",
        "name": "node1",
        "func": "const data = msg.payload;\n\nconst msgPh   = { payload: data.ph,          topic: \"ph\" };\nconst msgTds  = { payload: data.tds,         topic: \"tds\" };\nconst msgTurb = { payload: data.turbidity,   topic: \"turbidity\" };\nconst msgTemp = { payload: data.temperature, topic: \"temperature\" };\n\nreturn [msgPh, msgTds, msgTurb, msgTemp];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
